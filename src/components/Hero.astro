---
import { siteConfig } from "../config";

const { hero, social } = siteConfig;
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const socialLinks = [
  { label: "GitHub", href: social.github },
  { label: "LinkedIn", href: social.linkedin },
  { label: "Email", href: social.email ? `mailto:${social.email}` : "" },
].filter((link) => link.href);
---

<section
  id="hero"
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden bg-white px-6 pb-16 pt-16 sm:px-12 sm:pb-20 sm:pt-24 md:flex md:min-h-[min(880px,92svh)] md:items-center md:py-28 lg:px-16"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse at 0% 0%, ${siteConfig.accentColor}12, transparent 60%), radial-gradient(ellipse at 100% 45%, ${siteConfig.accentColor}08, transparent 55%)`}
  ></div>

  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-y-8 md:grid-cols-[1.2fr_1fr] md:gap-x-12 md:gap-y-7 lg:gap-x-20">
    <div class="md:self-end">
      <p class="mb-3 text-base font-medium text-gray-500 sm:text-lg">
        {hero.greeting}
      </p>
      <h1
        id="hero-title"
        class="text-6xl font-bold leading-[1.1] tracking-tight sm:text-7xl lg:text-8xl"
        style={`color: ${siteConfig.accentColor}`}
      >
        {siteConfig.name}
      </h1>
      <p class="mt-4 text-xl font-medium tracking-tight text-gray-800 sm:text-2xl">
        {siteConfig.title}
      </p>
    </div>

    <div class="mx-auto w-full max-w-[280px] md:col-start-2 md:row-span-2 md:row-start-1 md:max-w-[420px] md:self-center">
      <div class="overflow-hidden rounded-2xl border border-gray-200/80 bg-gray-50 shadow-sm">
        <img
          src={`${import.meta.env.BASE_URL}${hero.portrait}`}
          alt={hero.portraitAlt}
          width="800"
          height="800"
          fetchpriority="high"
          class="aspect-square h-auto w-full object-cover"
        />
      </div>
    </div>

    <div class="pt-3 md:col-start-1 md:row-start-2 md:pt-0">
      <p class="max-w-[32rem] text-base leading-relaxed text-gray-600 sm:text-lg sm:leading-relaxed">
        {hero.introduction}
      </p>

      {hero.availability && (
        <p class="mt-6 flex items-center gap-2.5 text-xs leading-relaxed text-gray-600 sm:text-sm">
          <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-emerald-600 ring-4 ring-emerald-600/10"></span>
          {hero.availability}
        </p>
      )}

      <div class="mt-8 flex flex-wrap gap-3">
        {hasProjects && (
          <a
            href="#projects"
            class="inline-flex min-h-12 items-center justify-center gap-3 rounded-lg bg-[var(--accent-color)] px-5 py-3 text-sm font-medium text-white transition duration-200 hover:-translate-y-0.5 hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-color)] motion-reduce:transform-none motion-reduce:transition-none"
          >
            {hero.projectsLabel}
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 7l10 10M17 7v10H7" />
            </svg>
          </a>
        )}
        {social.email && (
          <a
            href={`mailto:${social.email}`}
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white/70 px-5 py-3 text-sm font-medium text-gray-800 transition-colors hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-color)] motion-reduce:transition-none"
          >
            {hero.contactLabel}
          </a>
        )}
      </div>

      <ul aria-label="Social links" class="mt-5 flex flex-wrap items-center gap-x-4 text-sm text-gray-500">
        {socialLinks.map((link, index) => (
          <li class="flex items-center gap-4">
            {index > 0 && <span aria-hidden="true" class="text-gray-300">·</span>}
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              class="inline-flex min-h-11 items-center underline-offset-4 transition-colors hover:text-[var(--accent-color)] hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-color)]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
