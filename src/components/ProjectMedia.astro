---
import type { ProjectMedia } from "../config";

interface Props {
  media?: ProjectMedia[];
  projectName: string;
}

const { media = [], projectName } = Astro.props;

const mediaUrl = (src: string) =>
  /^(https?:)?\/\//.test(src)
    ? src
    : `${import.meta.env.BASE_URL}${src.replace(/^\//, "")}`;
---

{
  media.length > 0 && (
    <div
      class:list={[
        "grid gap-3",
        media.length === 1 ? "grid-cols-1 max-w-3xl" : "grid-cols-1 sm:grid-cols-2",
      ]}
      aria-label={`${projectName} media`}
    >
      {media.map((item) => (
        <figure class="overflow-hidden rounded-lg border border-gray-200 bg-white">
          {item.type === "video" ? (
            <video
              controls
              preload="metadata"
              poster={item.poster ? mediaUrl(item.poster) : undefined}
              aria-label={item.alt}
              class="aspect-video w-full bg-gray-950 object-cover"
            >
              <source src={mediaUrl(item.src)} />
              Your browser does not support embedded video.
            </video>
          ) : (
            <img
              src={mediaUrl(item.src)}
              alt={item.alt}
              loading="lazy"
              decoding="async"
              class="aspect-video w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
            />
          )}

          {item.caption && (
            <figcaption class="px-3 py-2 text-sm leading-relaxed text-gray-600">
              {item.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}
